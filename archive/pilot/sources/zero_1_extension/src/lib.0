fn slice(s: Span<u8>, a: usize, b: usize) -> Span<u8> {
    return std.mem.prefix(std.mem.dropPrefix(s, a), b - a)
}

fn nth(s: Span<u8>, wanted: usize) -> Span<u8> {
    var p: usize = 1
    var index: usize = 0
    while p < std.mem.len(s) {
        while p < std.mem.len(s) && (std.ascii.isWhitespace(s[p]) || s[p] == 44) {
            p = p + 1
        }
        if p >= std.mem.len(s) || s[p] == 93 {
            return ""
        }
        let start: usize = p
        var depth: usize = 0
        var quoted: Bool = false
        while p < std.mem.len(s) {
            let c: u8 = s[p]
            if quoted {
                if c == 92 {
                    p = p + 2
                    continue
                }
                if c == 34 {
                    quoted = false
                }
            } else if c == 34 {
                quoted = true
            } else if c == 91 || c == 123 {
                depth = depth + 1
            } else if c == 93 || c == 125 {
                if depth == 0 {
                    break
                }
                depth = depth - 1
            } else if c == 44 && depth == 0 {
                break
            }
            p = p + 1
        }
        if index == wanted {
            return std.str.trimAscii(slice(s, start, p))
        }
        index = index + 1
    }
    return ""
}

fn field(s: Span<u8>, key: Span<u8>) -> Span<u8> {
    let f: Maybe<Span<u8>> = std.json.field(s, key)
    if f.has {
        return f.value
    }
    return ""
}

fn decode(s: Span<u8>, buf: MutSpan<u8>) -> Span<u8> {
    let v: Maybe<Span<u8>> = std.json.stringDecode(buf, s)
    if v.has {
        return v.value
    }
    return ""
}

fn less(a: Span<u8>, b: Span<u8>) -> Bool {
    var i: usize = 0
    while i < std.mem.len(a) && i < std.mem.len(b) {
        if a[i] < b[i] {
            return true
        }
        if a[i] > b[i] {
            return false
        }
        i = i + 1
    }
    return std.mem.len(a) < std.mem.len(b)
}

fn put(o: mutref<Output>, out: MutSpan<u8>, s: Span<u8>) -> Void {
    var i: usize = 0
    while i < std.mem.len(s) {
        out[o.len] = s[i]
        o.len = o.len + 1
        i = i + 1
    }
}

fn number(o: mutref<Output>, out: MutSpan<u8>, n: i32) -> Void {
    var buf: [16]u8 = [0; 16]
    let v: Maybe<Span<u8>> = std.fmt.i32(buf, n)
    if v.has {
        put(o, out, v.value)
    }
}

fn unique(entries: Span<u8>, at: usize, a: MutSpan<u8>, b: MutSpan<u8>) -> Bool {
    let id: Span<u8> = decode(field(nth(entries, at), "id"), a)
    var j: usize = 0
    while j < at {
        let other: Span<u8> = decode(field(nth(entries, j), "id"), b)
        if std.mem.eql(id, other) {
            return false
        }
        j = j + 1
    }
    return true
}

fn ledger(input: Span<u8>, o: mutref<Output>, out: MutSpan<u8>) -> Void {
    var aa: [24000]u8 = [0; 24000]
    var bb: [24000]u8 = [0; 24000]
    var cc: [24000]u8 = [0; 24000]
    var dd: [24000]u8 = [0; 24000]
    var qq: [24000]u8 = [0; 24000]
    let a: MutSpan<u8> = aa
    let b: MutSpan<u8> = bb
    let bestbuf: MutSpan<u8> = cc
    let lastbuf: MutSpan<u8> = dd
    let quote: MutSpan<u8> = qq
    let entries: Span<u8> = field(input, "entries")
    var i: usize = 0
    var accepted: i32 = 0
    while std.mem.len(nth(entries, i)) > 0 {
        if unique(entries, i, a, b) {
            accepted = accepted + 1
            let account: Span<u8> = trim(decode(field(nth(entries, i), "account"), a))
            if std.mem.len(account) == 0 {
                put(o, out, "{\"error\":\"empty_account\"}")
                return
            }
        }
        i = i + 1
    }
    put(o, out, "{\"accounts\":[")
    var last: Span<u8> = ""
    var first: Bool = true
    while true {
        var best: Span<u8> = ""
        var found: Bool = false
        i = 0
        while std.mem.len(nth(entries, i)) > 0 {
            if unique(entries, i, a, b) {
                let account: Span<u8> = trim(decode(field(nth(entries, i), "account"), a))
                if (first || less(last, account)) && (!found || less(account, best)) {
                    let n: usize = std.mem.copy(bestbuf, account)
                    best = std.mem.prefix(bestbuf, n)
                    found = true
                }
            }
            i = i + 1
        }
        if !found {
            break
        }
        var balance: i32 = 0
        var count: i32 = 0
        i = 0
        while std.mem.len(nth(entries, i)) > 0 {
            if unique(entries, i, a, b) {
                let entry: Span<u8> = nth(entries, i)
                let account: Span<u8> = trim(decode(field(entry, "account"), a))
                if std.mem.eql(account, best) {
                    let amount: Maybe<i32> = std.parse.parseI32(field(entry, "amount"))
                    if amount.has {
                        balance = balance + amount.value
                    }
                    count = count + 1
                }
            }
            i = i + 1
        }
        if !first {
            put(o, out, ",")
        }
        put(o, out, "{\"account\":")
        let q: Maybe<Span<u8>> = std.json.writeStringBytes(quote, best)
        if q.has {
            put(o, out, q.value)
        }
        put(o, out, ",\"balance\":")
        number(o, out, balance)
        put(o, out, ",\"count\":")
        number(o, out, count)
        put(o, out, "}")
        let copied: usize = std.mem.copy(lastbuf, best)
        last = std.mem.prefix(lastbuf, copied)
        first = false
    }
    put(o, out, "],\"accepted\":")
    number(o, out, accepted)
    put(o, out, "}")
}

fn findNode(nodes: Span<u8>, raw: Span<u8>, a: MutSpan<u8>, b: MutSpan<u8>) -> usize {
    let name: Span<u8> = decode(raw, a)
    var i: usize = 0
    while std.mem.len(nth(nodes, i)) > 0 {
        if std.mem.eql(name, decode(nth(nodes, i), b)) {
            return i
        }
        i = i + 1
    }
    return i
}

fn topo(input: Span<u8>, o: mutref<Output>, out: MutSpan<u8>) -> Void {
    var aa: [40000]u8 = [0; 40000]
    var bb: [40000]u8 = [0; 40000]
    var cc: [40000]u8 = [0; 40000]
    let a: MutSpan<u8> = aa
    let b: MutSpan<u8> = bb
    let done: MutSpan<u8> = cc
    let nodes: Span<u8> = field(input, "nodes")
    let edges: Span<u8> = field(input, "edges")
    var n: usize = 0
    while std.mem.len(nth(nodes, n)) > 0 {
        done[n] = 0
        n = n + 1
    }
    var e: usize = 0
    while std.mem.len(nth(edges, e)) > 0 {
        let edge: Span<u8> = nth(edges, e)
        if findNode(nodes, nth(edge, 0), a, b) == n || findNode(nodes, nth(edge, 1), a, b) == n {
            put(o, out, "{\"error\":\"unknown_node\"}")
            return
        }
        e = e + 1
    }
    put(o, out, "{\"order\":[")
    var step: usize = 0
    while step < n {
        var best: usize = n
        var i: usize = 0
        while i < n {
            if done[i] == 0 {
                var available: Bool = true
                e = 0
                while std.mem.len(nth(edges, e)) > 0 {
                    let edge: Span<u8> = nth(edges, e)
                    if findNode(nodes, nth(edge, 1), a, b) == i {
                        let source: usize = findNode(nodes, nth(edge, 0), a, b)
                        if done[source] == 0 {
                            available = false
                            break
                        }
                    }
                    e = e + 1
                }
                if available {
                    if best == n {
                        best = i
                    } else if less(decode(nth(nodes, i), a), decode(nth(nodes, best), b)) {
                        best = i
                    }
                }
            }
            i = i + 1
        }
        if best == n {
            o.len = 0
            put(o, out, "{\"error\":\"cycle\"}")
            return
        }
        if step > 0 {
            put(o, out, ",")
        }
        put(o, out, nth(nodes, best))
        done[best] = 1
        step = step + 1
    }
    put(o, out, "]}")
}

fn precedence(op: u8) -> u32 {
    if op == 80 || op == 78 {
        return 3
    }
    if op == 42 || op == 47 {
        return 2
    }
    if op == 43 || op == 45 {
        return 1
    }
    return 0
}

fn reduce(s: mutref<Stack>, values: MutSpan<i32>, ops: MutSpan<u8>) -> Void {
    if s.on == 0 || s.vn == 0 {
        s.error = 1
        return
    }
    s.on = s.on - 1
    let op: u8 = ops[s.on]
    if op == 80 {
        return
    }
    if op == 78 {
        values[s.vn - 1] = -values[s.vn - 1]
        return
    }
    if s.vn < 2 || op == 40 {
        s.error = 1
        return
    }
    s.vn = s.vn - 1
    let rhs: i32 = values[s.vn]
    let lhs: i32 = values[s.vn - 1]
    if op == 43 {
        values[s.vn - 1] = lhs + rhs
    }
    if op == 45 {
        values[s.vn - 1] = lhs - rhs
    }
    if op == 42 {
        values[s.vn - 1] = lhs * rhs
    }
    if op == 47 {
        if rhs == 0 {
            s.error = 2
            return
        }
        values[s.vn - 1] = lhs / rhs
    }
}

fn calculate(text: Span<u8>, o: mutref<Output>, out: MutSpan<u8>) -> Void {
    var values: [16384]i32 = [0; 16384]
    var ops: [32768]u8 = [0; 32768]
    var s: Stack = Stack { vn: 0, on: 0, error: 0 }
    var p: usize = 0
    var need: Bool = true
    while p < std.mem.len(text) && s.error == 0 {
        let c: u8 = text[p]
        if whitespace(c) {
            p = p + 1
            continue
        }
        if need {
            if c == 43 || c == 45 {
                if c == 43 {
                    ops[s.on] = 80
                } else {
                    ops[s.on] = 78
                }
                s.on = s.on + 1
                p = p + 1
                continue
            }
            if c == 40 {
                ops[s.on] = 40
                s.on = s.on + 1
                p = p + 1
                continue
            }
            if !std.ascii.isDigit(c) {
                s.error = 1
                break
            }
            var v: i32 = 0
            while p < std.mem.len(text) && std.ascii.isDigit(text[p]) {
                v = v * 10 + text[p] as i32 - 48
                p = p + 1
            }
            values[s.vn] = v
            s.vn = s.vn + 1
            need = false
        } else if c == 41 {
            while s.on > 0 && ops[s.on - 1] != 40 && s.error == 0 {
                reduce(&mut s, values, ops)
            }
            if s.on == 0 {
                s.error = 1
                break
            }
            s.on = s.on - 1
            p = p + 1
        } else {
            if c != 43 && c != 45 && c != 42 && c != 47 {
                s.error = 1
                break
            }
            while s.on > 0 && precedence(ops[s.on - 1]) >= precedence(c) && s.error == 0 {
                reduce(&mut s, values, ops)
            }
            ops[s.on] = c
            s.on = s.on + 1
            p = p + 1
            need = true
        }
    }
    if need && s.error == 0 {
        s.error = 1
    }
    while s.on > 0 && s.error == 0 {
        reduce(&mut s, values, ops)
    }
    if s.error == 2 {
        put(o, out, "{\"error\":\"division_by_zero\"}")
        return
    }
    if s.error != 0 || s.vn != 1 {
        put(o, out, "{\"error\":\"syntax\"}")
        return
    }
    put(o, out, "{\"value\":")
    number(o, out, values[0])
    put(o, out, "}")
}

fn dispatch(input: Span<u8>, output: MutSpan<u8>) -> usize {
    var storage: [130000]u8 = [0; 130000]
    let a: MutSpan<u8> = storage
    var o: Output = Output { len: 0 }
    let op: Span<u8> = decode(field(input, "op"), a)
    if std.mem.eql(op, "ledger") {
        ledger(input, &mut o, output)
    } else if std.mem.eql(op, "topo") {
        topo(input, &mut o, output)
    } else if std.mem.eql(op, "merge") {
        merge(input, &mut o, output)
    } else if std.mem.eql(op, "calc") {
        calculate(decode(field(input, "expr"), a), &mut o, output)
    } else {
        put(&mut o, output, "{\"error\":\"unknown_op\"}")
    }
    return o.len
}

fn whitespace(c: u8) -> Bool {
    return c == 32 || c >= 9 && c <= 13
}

fn trim(s: Span<u8>) -> Span<u8> {
    var a: usize = 0
    var b: usize = std.mem.len(s)
    while a < b && whitespace(s[a]) {
        a = a + 1
    }
    while b > a && whitespace(s[b - 1]) {
        b = b - 1
    }
    return slice(s, a, b)
}

fn merge(input: Span<u8>, o: mutref<Output>, out: MutSpan<u8>) -> Void {
    let intervals: Span<u8> = field(input, "intervals")
    var i: usize = 0
    while std.mem.len(nth(intervals, i)) > 0 {
        let entry: Span<u8> = nth(intervals, i)
        let start: Maybe<i32> = std.parse.parseI32(nth(entry, 0))
        let end: Maybe<i32> = std.parse.parseI32(nth(entry, 1))
        if start.has && end.has {
            if start.value > end.value {
                put(o, out, "{\"error\":\"invalid_interval\"}")
                return
            }
        }
        i = i + 1
    }
    put(o, out, "{\"intervals\":[")
    var have: Bool = false
    var first: Bool = true
    var last: i32 = 0
    var currentStart: i32 = 0
    var currentEnd: i32 = 0
    while true {
        var found: Bool = false
        var bestStart: i32 = 0
        var bestEnd: i32 = 0
        i = 0
        while std.mem.len(nth(intervals, i)) > 0 {
            let entry: Span<u8> = nth(intervals, i)
            let start: Maybe<i32> = std.parse.parseI32(nth(entry, 0))
            let end: Maybe<i32> = std.parse.parseI32(nth(entry, 1))
            if start.has && end.has {
                if !have || start.value > last {
                    if !found || start.value < bestStart {
                        bestStart = start.value
                        bestEnd = end.value
                        found = true
                    } else if start.value == bestStart && end.value > bestEnd {
                        bestEnd = end.value
                    }
                }
            }
            i = i + 1
        }
        if !found {
            break
        }
        if !have {
            currentStart = bestStart
            currentEnd = bestEnd
        } else if bestStart <= currentEnd {
            if bestEnd > currentEnd {
                currentEnd = bestEnd
            }
        } else {
            if !first {
                put(o, out, ",")
            }
            put(o, out, "[")
            number(o, out, currentStart)
            put(o, out, ",")
            number(o, out, currentEnd)
            put(o, out, "]")
            first = false
            currentStart = bestStart
            currentEnd = bestEnd
        }
        last = bestStart
        have = true
    }
    if have {
        if !first {
            put(o, out, ",")
        }
        put(o, out, "[")
        number(o, out, currentStart)
        put(o, out, ",")
        number(o, out, currentEnd)
        put(o, out, "]")
    }
    put(o, out, "]}")
}
