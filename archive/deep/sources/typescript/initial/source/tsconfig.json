{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": [
      "node"
    ],
    "typeRoots": [
      "{ORIGINAL_BENCHMARK_ROOT}/toolchains/typescript/node_modules/@types"
    ],
    "outDir": "dist",
    "noEmitOnError": true,
    "skipLibCheck": true,
    "removeComments": true
  },
  "include": [
    "*.ts"
  ]
}
